rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // Clients may only create their own profile, without any offer; plan and credits are server-managed afterwards.
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.plan == "none"
        && request.resource.data.credits == 0;
      allow update, delete: if false;

      // Analyses are written by the /api/analyze route (Admin SDK) only.
      match /analyses/{analysisId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // Anonymous activity feed: written and read by the server only (Admin SDK).
    match /activity/{entryId} {
      allow read, write: if false;
    }

    // One review per user, moderated by hand before anything is published on the site.
    match /reviews/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["uid", "rating", "text", "publishConsent", "displayName", "createdAt"])
        && request.resource.data.uid == uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 10 && request.resource.data.text.size() <= 600
        && request.resource.data.publishConsent is bool
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
