# Firebase web app config (Console Firebase → Paramètres du projet → Vos applications)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Serveur uniquement (ne pas préfixer par NEXT_PUBLIC_)
ANTHROPIC_API_KEY=
# JSON du compte de service Firebase (Paramètres du projet → Comptes de service), sur une seule ligne.
# Inutile sur Firebase App Hosting / Cloud Run (identifiants par défaut).
FIREBASE_SERVICE_ACCOUNT=

# Stripe (serveur uniquement)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# ID du prix récurrent de l'abonnement Pro (price_...)
STRIPE_PRICE_PRO=
# URL publique de l'app, pour les redirections Stripe (ex. https://app.mondomaine.com)
APP_URL=http://localhost:3000
